# ===== LLM (ключ и адрес выдают организаторы) =====
# Адрес OpenAI-совместимого API, БЕЗ /chat/completions на конце, например: https://llm.example.ru/v1
LLM_BASE_URL=
LLM_API_KEY=

# Один ключ даёт доступ ко всем шести моделям (слайд 18); модель выбирается в каждом запросе.
# Названия — точно как в API организаторов (проверьте: ./alfa-insight llm-models).
# Gemma 4 26B A4B — простые задачи: план агента
LLM_MODEL_FAST=gemma-4-26b-a4b
# GLM-5.3-Flash — глубокий анализ: интерпретация события
LLM_MODEL_REASONING=glm-5.3-flash
# Qwen3.6 35B A3B — универсальная: ответы на вопросы, резерв
LLM_MODEL_GENERAL=qwen3.6-35b-a3b
# DeepSeek-V4.1-Flash — поиск взаимосвязей: вопросы по всей ленте, критик-проверяющий
LLM_MODEL_RESEARCH=deepseek-v4.1-flash
# Kimi-K2.6 — анализ текста: резерв писателя
LLM_MODEL_TEXT=kimi-k2.6
# Qwen3-VL-30B-A3B-Instruct — изображения: графики и сканы в PDF аналитики
LLM_MODEL_VISION=qwen3-vl-30b-a3b-instruct

# Бюджет: 500 ₽/день — ОБЩИЙ на всю команду и все модели. Счётчик видит только свой экземпляр
# сервиса, поэтому задайте каждому участнику долю (например, 150 ₽ на демо-сервер).
LLM_DAILY_BUDGET_RUB=150
LLM_DAILY_TOKEN_LIMIT=400000
# Цены, ₽ за 1 млн токенов «вход,выход» (узнайте у организаторов). Без цен учёт в рублях выключен,
# работает только лимит токенов.
LLM_PRICE_FAST=
LLM_PRICE_REASONING=
LLM_PRICE_GENERAL=
LLM_PRICE_RESEARCH=
LLM_PRICE_TEXT=
LLM_PRICE_VISION=
# Повторные одинаковые запросы не тратят бюджет
LLM_CACHE=true
# Рассуждения (thinking) у GLM, Kimi, Qwen3.6, DeepSeek: false — в 4–7 раз дешевле, ответ не обрезается
LLM_THINKING=false
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120
LLM_MAX_AGENT_STEPS=6
# auto | offline (принудительно без LLM)
LLM_MODE=auto

# Расшифровка графиков/сканов в PDF аналитики моделью Qwen3-VL (тратит бюджет один раз, результат кэшируется)
ANALYTICS_VISION_OCR=false
ANALYTICS_VISION_MAX_PAGES=15

# ===== Эмбеддинги =====
# tfidf (без моделей) | bge (BGE-M3 через Ollama — уточните допустимость у организаторов)
EMBEDDING_PROVIDER=tfidf
BGE_MODEL=bge-m3
BGE_ENDPOINT=http://localhost:11434
BGE_API=ollama

# ===== Новости =====
# reference (тестовые новости) | live (RSS из configs/sources.json) | file
NEWS_MODE=reference
NEWS_FILE=
NEWS_HOURS=72
REQUEST_TIMEOUT=20
MAX_PER_SOURCE=25
MAX_TOTAL=400

# ===== Сервер =====
ADDR=:8080
